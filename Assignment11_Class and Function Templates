#include <iostream>
#include <string>
using namespace std;

// Function template
template <class T>
T maximumValue(T a, T b)
{
    return (a > b) ? a : b;
}

// Class template
template <class T>
class Box
{
    T value;
public:
    Box(T v) { value = v; }
    void display() { cout << "Box value = " << value << endl; }
};

int main()
{
    cout << "Maximum integer = " << maximumValue(10, 25) << endl;
    cout << "Maximum double  = " << maximumValue(5.5, 3.2) << endl;

    Box<int> b1(100);
    Box<string> b2("C++ Templates");
    b1.display();
    b2.display();
    return 0;
}


